# Razorpay — public key is safe to expose in frontend code.
# NEVER put your Razorpay Key SECRET in this file or in any frontend code.
# The secret stays server-side only, used by whatever backend/serverless
# function creates the Razorpay order (see README "Payment backend" section).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Base URL of the backend endpoint that creates a Razorpay order and
# verifies payment signatures. Point this at your serverless function
# or backend service.
VITE_ORDER_API_BASE_URL=https://your-backend.example.com/api

# Optional: Google Maps/Places API key if you later want geocoded
# addresses instead of raw lat/lng. Not required for Phase 1.
VITE_GOOGLE_MAPS_API_KEY=
